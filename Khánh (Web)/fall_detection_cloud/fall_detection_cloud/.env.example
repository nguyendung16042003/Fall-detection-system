DATABASE_URL=postgresql://postgres:postgres@localhost:5432/falldetection
SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
RABBITMQ_EXCHANGE=fall_detection
RABBITMQ_ENABLED=false

# MQTT (RabbitMQ MQTT plugin, port 1883) - Edge publish event/telemetry
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_USERNAME=guest
MQTT_PASSWORD=guest
MQTT_ENABLED=true
MQTT_TOPIC_FALL=events/+/fall
MQTT_TOPIC_TELEMETRY=telemetry/+/status

# MinIO (lưu snapshot) - để trống MINIO_ENDPOINT = bỏ qua upload
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=fall-events
MINIO_SECURE=false
MINIO_PUBLIC_URL=

# Live view HLS (MediaMTX, tuần 5)
MEDIAMTX_BASE_URL=http://localhost:8888

# Telemetry: camera coi là online nếu nhận tin trong N giây
TELEMETRY_ONLINE_WINDOW_SEC=60

# VLM (Gemini Flash) - để trống = dry-run
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
VLM_ENABLED=true

# FCM (Firebase Admin SDK) - đường dẫn service account JSON
FCM_CREDENTIALS_FILE=
FCM_ENABLED=true

# Telegram Bot - để trống = dry-run
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
