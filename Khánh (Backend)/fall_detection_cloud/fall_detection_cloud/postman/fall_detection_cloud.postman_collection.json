{
 "info": {
  "name": "Fall Detection Cloud API",
  "description": "Bộ sưu tập request mẫu cho Auth, Users, Cameras và Rules. Dùng cho team Mobile (Tấn Dũng) tích hợp.\n\nCách dùng:\n1. Đặt biến `base_url` (mặc định http://localhost:8000).\n2. Chạy `Auth / Login` (tài khoản seed: admin@example.com / admin123). Script tự lưu access_token & refresh_token vào biến collection.\n3. Các request được bảo vệ tự dùng `{{access_token}}` qua Bearer auth.",
  "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
 },
 "auth": {
  "type": "bearer",
  "bearer": [
   {
    "key": "token",
    "value": "{{access_token}}",
    "type": "string"
   }
  ]
 },
 "variable": [
  {
   "key": "base_url",
   "value": "http://localhost:8000"
  },
  {
   "key": "access_token",
   "value": ""
  },
  {
   "key": "refresh_token",
   "value": ""
  },
  {
   "key": "camera_id",
   "value": ""
  },
  {
   "key": "event_id",
   "value": ""
  }
 ],
 "item": [
  {
   "name": "Health",
   "item": [
    {
     "name": "Root",
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        ""
       ]
      }
     }
    },
    {
     "name": "Health check",
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/health",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "health"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "Auth",
   "item": [
    {
     "name": "Register",
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"newuser@example.com\",\n  \"password\": \"secret123\",\n  \"full_name\": \"Người dùng mới\",\n  \"role\": \"caregiver\"\n}"
      },
      "url": {
       "raw": "{{base_url}}/api/v1/auth/register",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "auth",
        "register"
       ]
      }
     }
    },
    {
     "name": "Login",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var data = pm.response.json();",
         "if (data.access_token) {",
         "  pm.collectionVariables.set('access_token', data.access_token);",
         "  pm.collectionVariables.set('refresh_token', data.refresh_token);",
         "}",
         "pm.test('status 200', function () { pm.response.to.have.status(200); });"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"email\": \"admin@example.com\",\n  \"password\": \"admin123\"\n}"
      },
      "url": {
       "raw": "{{base_url}}/api/v1/auth/login",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "auth",
        "login"
       ]
      }
     }
    },
    {
     "name": "Refresh token",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var data = pm.response.json();",
         "if (data.access_token) {",
         "  pm.collectionVariables.set('access_token', data.access_token);",
         "  pm.collectionVariables.set('refresh_token', data.refresh_token);",
         "}"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "auth": {
       "type": "noauth"
      },
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}"
      },
      "url": {
       "raw": "{{base_url}}/api/v1/auth/refresh",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "auth",
        "refresh"
       ]
      }
     }
    }
   ]
  },
  {
