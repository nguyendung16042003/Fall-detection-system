     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/api/v1/rules/{{camera_id}}",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "rules",
        "{{camera_id}}"
       ]
      }
     }
    },
    {
     "name": "Upsert camera rule",
     "request": {
      "method": "PUT",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"time_window_sec\": 2,\n  \"min_lying_frames\": 5,\n  \"high_confidence_threshold\": 0.85,\n  \"low_confidence_threshold\": 0.4,\n  \"enable_vlm_verify\": true,\n  \"enabled\": true\n}"
      },
      "url": {
       "raw": "{{base_url}}/api/v1/rules/{{camera_id}}",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "rules",
        "{{camera_id}}"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "Events",
   "item": [
    {
     "name": "Ingest event (Edge -> Cloud)",
     "event": [
      {
       "listen": "test",
       "script": {
        "type": "text/javascript",
        "exec": [
         "var d = pm.response.json();",
         "if (d.event_id) { pm.collectionVariables.set('event_id', d.event_id); }",
         "pm.test('status 201', function () { pm.response.to.have.status(201); });"
        ]
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"schema_version\": \"1.0.0\",\n  \"event_id\": \"evt_20260531_000001\",\n  \"event_type\": \"fall_candidate\",\n  \"severity\": \"high\",\n  \"edge_device_id\": \"jetson_nano_01\",\n  \"camera_id\": \"{{camera_id}}\",\n  \"source_id\": 0,\n  \"person_id\": 3,\n  \"timestamp\": \"2026-06-08T10:30:12Z\",\n  \"bbox\": {\n    \"x1\": 120,\n    \"y1\": 80,\n    \"x2\": 300,\n    \"y2\": 420\n  },\n  \"state_before\": \"standing\",\n  \"state_after\": \"lying\",\n  \"transition_time_ms\": 1200,\n  \"classification_confidence\": 0.88,\n  \"fall_confidence\": 0.86,\n  \"snapshot_path\": \"edge://cam_01/events/evt.jpg\",\n  \"clip_path\": \"edge://cam_01/events/evt.mp4\",\n  \"rule_version\": \"temporal_v1\"\n}",
       "options": {
        "raw": {
         "language": "json"
        }
       }
      },
      "url": {
       "raw": "{{base_url}}/api/v1/events",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "events"
       ]
      },
      "description": "Edge gửi sự kiện ngã. severity=high -> queue fall_events.high, ngược lại fall_events.low. camera_id là UUID camera trong DB."
     }
    },
    {
     "name": "List events (history + filter + pagination)",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/api/v1/events?page=1&limit=20&severity=high&camera_id={{camera_id}}",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "events"
       ],
       "query": [
        {
         "key": "page",
         "value": "1"
        },
        {
         "key": "limit",
         "value": "20"
        },
        {
         "key": "severity",
         "value": "high"
        },
        {
         "key": "camera_id",
         "value": "{{camera_id}}"
        }
       ]
      },
      "description": "Filter: camera_id, from (ISO), to (ISO), severity (high/low), status (new/acknowledged/resolved). Phân trang: page, limit."
     }
    },
    {
     "name": "Get event detail",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/api/v1/events/{{event_id}}",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "events",
        "{{event_id}}"
       ]
      },
      "description": "Chi tiết 1 sự kiện theo UUID."
     }
    }
   ]
  },
