    },
    {
     "name": "Delete a device",
     "request": {
      "method": "DELETE",
      "url": {
       "raw": "{{base_url}}/api/v1/users/me/devices/android_device_001",
       "host": [
        "{{base_url}}"
       ],
       "path": [
