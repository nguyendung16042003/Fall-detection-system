        "me",
        "devices",
        "android_device_001"
       ]
      }
     }
    }
   ]
  },
  {
   "name": "Cameras",
   "item": [
    {
     "name": "List cameras",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/api/v1/cameras",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "cameras"
       ]
      }
     }
    },
    {
     "name": "Create camera",
     "event": [
      {
       "listen": "test",
       "script": {
        "exec": [
         "var data = pm.response.json();",
         "if (data.id) { pm.collectionVariables.set('camera_id', data.id); }"
        ],
        "type": "text/javascript"
       }
      }
     ],
     "request": {
      "method": "POST",
      "header": [
       {
        "key": "Content-Type",
        "value": "application/json"
       }
      ],
      "body": {
       "mode": "raw",
       "raw": "{\n  \"name\": \"Camera Phòng Khách\",\n  \"rtsp_url\": \"rtsp://admin:pass@192.168.1.100:554/stream\",\n  \"edge_device_id\": \"jetson_nano_01\",\n  \"location_note\": \"Phòng khách tầng 1\"\n}"
      },
      "url": {
       "raw": "{{base_url}}/api/v1/cameras",
       "host": [
        "{{base_url}}"
       ],
       "path": [
