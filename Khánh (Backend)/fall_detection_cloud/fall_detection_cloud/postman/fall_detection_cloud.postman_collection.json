       ],
       "path": [
        "api",
        "v1",
        "telemetry"
       ]
      },
      "description": "Lưu telemetry + publish queue telemetry_events."
     }
    },
    {
     "name": "Get edge status",
     "request": {
      "method": "GET",
      "url": {
       "raw": "{{base_url}}/api/v1/telemetry/jetson_nano_01",
       "host": [
        "{{base_url}}"
       ],
       "path": [
        "api",
        "v1",
        "telemetry",
        "jetson_nano_01"
       ]
      },
      "description": "Telemetry mới nhất của 1 edge device."
     }
    }
   ]
  }
 ]
}