{
  "info": {
    "name": "Fall Detection Cloud API (v2)",
    "description": "Bộ sưu tập request theo api_contract_v2. Prefix /api.\n\nCách dùng:\n1. Đặt biến base_url (mặc định http://localhost:8000).\n2. Chạy Auth / Login (seed: admin / admin123). Script tự lưu access_token + refresh_token.\n3. Request bảo vệ dùng {{access_token}} qua Bearer auth.\n4. cam_id mẫu: cam_01, cam_02 (chạy seed.py).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{access_token}}", "type": "string" }]
  },
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "access_token", "value": "" },
    { "key": "refresh_token", "value": "" },
    { "key": "cam_id", "value": "cam_01" },
    { "key": "event_id", "value": "" },
    { "key": "alert_id", "value": "" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Health check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": { "raw": "{{base_url}}/health", "host": ["{{base_url}}"], "path": ["health"] }
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"newuser\",\n  \"password\": \"secret123\",\n  \"email\": \"newuser@example.com\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/register", "host": ["{{base_url}}"], "path": ["api", "auth", "register"] }
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.access_token) pm.collectionVariables.set('access_token', d.access_token);",
                  "if (d.refresh_token) pm.collectionVariables.set('refresh_token', d.refresh_token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/login", "host": ["{{base_url}}"], "path": ["api", "auth", "login"] }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"refresh_token\": \"{{refresh_token}}\"\n}" },
            "url": { "raw": "{{base_url}}/api/auth/refresh", "host": ["{{base_url}}"], "path": ["api", "auth", "refresh"] }
          }
        }
      ]
    },
    {
      "name": "Users / Devices",
      "item": [
        {
          "name": "Get me",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/users/me", "host": ["{{base_url}}"], "path": ["api", "users", "me"] }
          }
        },
        {
          "name": "Register FCM token",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"device_id\": \"android_device_001\",\n  \"platform\": \"android\",\n  \"fcm_token\": \"fcm_token_abc...\"\n}" },
            "url": { "raw": "{{base_url}}/api/devices/fcm-token", "host": ["{{base_url}}"], "path": ["api", "devices", "fcm-token"] }
          }
        }
      ]
    },
    {
      "name": "Cameras",
      "item": [
        {
          "name": "List cameras",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/cameras", "host": ["{{base_url}}"], "path": ["api", "cameras"] }
          }
        },
        {
          "name": "Create camera",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"cam_id\": \"cam_03\",\n  \"name\": \"Camera Bếp\",\n  \"rtsp_url\": \"rtsp://admin:pass@192.168.1.102:554/stream1\",\n  \"location\": \"Bếp tầng 1\",\n  \"edge_device_id\": \"jetson_nano_03\",\n  \"is_active\": true\n}" },
            "url": { "raw": "{{base_url}}/api/cameras", "host": ["{{base_url}}"], "path": ["api", "cameras"] }
          }
        },
        {
          "name": "Get camera",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/cameras/{{cam_id}}", "host": ["{{base_url}}"], "path": ["api", "cameras", "{{cam_id}}"] }
          }
        },
        {
          "name": "Update camera",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"Camera Phòng Khách (đổi tên)\",\n  \"is_active\": false\n}" },
            "url": { "raw": "{{base_url}}/api/cameras/{{cam_id}}", "host": ["{{base_url}}"], "path": ["api", "cameras", "{{cam_id}}"] }
          }
        },
        {
          "name": "Delete camera",
          "request": {
            "method": "DELETE",
            "url": { "raw": "{{base_url}}/api/cameras/{{cam_id}}", "host": ["{{base_url}}"], "path": ["api", "cameras", "{{cam_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Config (rules)",
      "item": [
        {
          "name": "Get rules config",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/config/rules", "host": ["{{base_url}}"], "path": ["api", "config", "rules"] }
          }
        },
        {
          "name": "Update rules config",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"fall_detection\": { \"transition_window_ms\": 2000, \"confirm_frames\": 5, \"min_confidence_sgie\": 0.5 },\n  \"dedup\": { \"window_ms\": 3000 },\n  \"vlm\": { \"enabled\": true },\n  \"notifications\": { \"fcm_enabled\": true, \"cameras\": { \"cam_01\": { \"notify\": true } } }\n}" },
            "url": { "raw": "{{base_url}}/api/config/rules", "host": ["{{base_url}}"], "path": ["api", "config", "rules"] }
          }
        }
      ]
    },
    {
      "name": "Events",
      "item": [
        {
          "name": "Create event (REST fallback - mqtt fall_event)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.id) pm.collectionVariables.set('event_id', d.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"schema_version\": \"2.0\",\n  \"event_id\": \"3b1c8d2e-7f4a-4b9c-9d1e-2a3b4c5d6e7f\",\n  \"cam_id\": \"cam_01\",\n  \"person_id\": 1,\n  \"timestamp\": \"2026-06-20T07:00:00Z\",\n  \"event_type\": \"fall_candidate\",\n  \"detection\": {\n    \"class_before\": \"standing\",\n    \"final_class\": \"lying\",\n    \"confidence\": 0.62,\n    \"bbox_xyxy\": [100, 120, 320, 400],\n    \"frame_width\": 1280,\n    \"frame_height\": 720\n  },\n  \"rule\": { \"trigger\": \"transition\", \"transition_ms\": 800, \"window_ms\": 2000 },\n  \"frames\": [{ \"offset_ms\": 0, \"jpeg_b64\": \"/9j/2Q==\" }]\n}" },
            "url": { "raw": "{{base_url}}/api/events", "host": ["{{base_url}}"], "path": ["api", "events"] }
          }
        },
        {
          "name": "List events (filter + pagination)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/events?cam_id=cam_01&status=confirmed&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "events"],
              "query": [
                { "key": "cam_id", "value": "cam_01" },
                { "key": "status", "value": "confirmed" },
                { "key": "start_date", "value": "2026-06-01", "disabled": true },
                { "key": "end_date", "value": "2026-06-30", "disabled": true },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get event",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/events/{{event_id}}", "host": ["{{base_url}}"], "path": ["api", "events", "{{event_id}}"] }
          }
        }
      ]
    },
    {
      "name": "Alerts",
      "item": [
        {
          "name": "List alerts",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var d = pm.response.json();",
                  "if (d.items && d.items.length) pm.collectionVariables.set('alert_id', d.items[0].id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/alerts?acknowledged=false&page=1&page_size=20",
              "host": ["{{base_url}}"],
              "path": ["api", "alerts"],
              "query": [
                { "key": "cam_id", "value": "cam_01", "disabled": true },
                { "key": "acknowledged", "value": "false" },
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" }
              ]
            }
          }
        },
        {
          "name": "Get alert",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/alerts/{{alert_id}}", "host": ["{{base_url}}"], "path": ["api", "alerts", "{{alert_id}}"] }
          }
        },
        {
          "name": "Acknowledge alert (empty body)",
          "request": {
            "method": "PATCH",
            "url": { "raw": "{{base_url}}/api/alerts/{{alert_id}}/acknowledge", "host": ["{{base_url}}"], "path": ["api", "alerts", "{{alert_id}}", "acknowledge"] }
          }
        }
      ]
    },
    {
      "name": "Telemetry",
      "item": [
        {
          "name": "Get latest telemetry",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/telemetry/{{cam_id}}/latest", "host": ["{{base_url}}"], "path": ["api", "telemetry", "{{cam_id}}", "latest"] }
          }
        }
      ]
    },
    {
      "name": "Live",
      "item": [
        {
          "name": "Get live HLS url",
          "request": {
            "method": "GET",
            "url": { "raw": "{{base_url}}/api/live/{{cam_id}}", "host": ["{{base_url}}"], "path": ["api", "live", "{{cam_id}}"] }
          }
        }
      ]
    }
  ]
}
